# HTTP port, на котором слушает self-hosted сервер.
PORT=3000

# Host path, который docker compose монтирует внутрь контейнера как /data.
AQA_PULSE_HOST_DATA_DIR=./data

# Корневая директория server-side данных: registry, workspace data, raw reports, artifacts.
AQA_PULSE_DATA_ROOT=/data

# Storage driver для данных workspace и сервера: file, sqlite или postgres.
AQA_PULSE_STORAGE_DRIVER=sqlite

# Путь к SQLite базе. Используется только если AQA_PULSE_STORAGE_DRIVER=sqlite.
AQA_PULSE_SQLITE_PATH=/data/aqa-pulse.sqlite

# Connection string Postgres. Используется только если AQA_PULSE_STORAGE_DRIVER=postgres.
AQA_PULSE_POSTGRES_URL=

# Raw admin token для initial admin login и административных операций.
AQA_PULSE_ADMIN_TOKEN=change-me-admin-token

# Секрет для подписи admin/workspace JWT и session cookies.
AQA_PULSE_JWT_SECRET=change-me-jwt-secret

# TTL access token/session в секундах. 28800 = 8 часов.
AQA_PULSE_ACCESS_TOKEN_TTL_SECONDS=28800

# Максимальный размер тела запроса для API в формате JSON. Увеличьте, если ожидаете большие payloads (например, большие raw reports).
AQA_PULSE_REQUEST_BODY_LIMIT=50mb

# Включает dev bootstrap routes. Для production/self-hosted обычно должно быть false.
AQA_PULSE_ENABLE_DEV_BOOTSTRAP=false

# Если true, чтение dashboard и workspace API требует workspace user token/login.
AQA_PULSE_REQUIRE_WORKSPACE_AUTH=true

