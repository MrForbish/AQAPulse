{
  "name": "aqa-pulse-server",
  "version": "0.1.0",
  "private": true,
  "description": "Внутренний self-hosted server package для AQA Pulse",
  "license": "UNLICENSED",
  "keywords": [
    "playwright",
    "dashboard",
    "observability",
    "analytics",
    "qa"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/backend/index.js",
  "types": "./dist/backend/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/backend/index.d.ts",
      "default": "./dist/backend/index.js"
    }
  },
  "bin": {
    "aqa-pulse-server": "./bin/aqa-pulse-server.js"
  },
  "files": [
    "dist/**/*",
    "bin/**/*",
    "scripts/install-self-hosted.ps1",
    "scripts/self-hosted-utils.js",
    "scripts/update-self-hosted.js",
    "scripts/setup-self-hosted.js",
    "template/**/*",
    "README.md",
    "SELF-HOSTED-DEPLOYMENT.md",
    "SELF-HOSTED-QUICKSTART.md",
    "SELF-HOSTED-INSTALL.md",
    "GITLAB-CI-INTEGRATION.md",
    "Dockerfile",
    "docker-compose.yml",
    ".env.example"
  ],
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist',{recursive:true,force:true});\"",
    "build": "npm --prefix ../aqa-pulse run compile && node ./scripts/build-package.js",
    "docker:up": "npm run build && docker compose up --build",
    "docker:down": "docker compose down",
    "docker:restart": "docker compose restart aqa-pulse-server",
    "update:docker": "node ./scripts/update-self-hosted.js",
    "setup:docker": "node ./scripts/setup-self-hosted.js",
    "start": "node ./bin/aqa-pulse-server.js start",
    "init": "node ./bin/aqa-pulse-server.js init",
    "bootstrap:workspace": "node ./bin/aqa-pulse-server.js bootstrap-workspace",
    "bootstrap-demo": "node ./bin/aqa-pulse-server.js bootstrap-demo",
    "sqlite:migrate": "node ./bin/aqa-pulse-server.js sqlite-migrate",
    "sqlite:backup": "node ./bin/aqa-pulse-server.js sqlite-backup",
    "pack:check": "npm run build && npm pack --dry-run",
    "prepublishOnly": "node -e \"console.error('Пакет aqa-pulse-server является внутренним и не предназначен для публикации.'); process.exit(1)\""
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}

